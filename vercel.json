{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "dsm-ui": {
      "root": "dsm-ui",
      "framework": "vite"
    },
    "app": {
      "root": ".",
      "runtime": "node",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "dsm-ui"
      }
    }
  ]
}
